{
  "name": "a-mesa-server",
  "version": "1.0.0",
  "private": true,
  "description": "API do À Mesa — pedidos por QR code",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
