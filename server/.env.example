# Copia para .env e ajusta.
# Base de dados: por omissão, o PostgreSQL local do `npm run dev` (na raiz do projeto).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/a_mesa?schema=public"
# Segredo dos tokens de sessão. Em produção: obrigatório, 32+ caracteres aleatórios.
JWT_SECRET="troca-isto-por-uma-frase-longa-e-aleatoria"
PORT=4000
# Em produção (obrigatório): o URL do site no Vercel. Vários separados por vírgulas.
FRONTEND_URL=""
# URL do site usado nos links de recuperação de senha (por omissão, o 1.º de FRONTEND_URL).
APP_URL=""
# Email (recuperação de senha). Sem isto, em desenvolvimento os emails aparecem na consola.
# Ex.: smtps://utilizador:senha-de-aplicacao@smtp.gmail.com:465
SMTP_URL=""
EMAIL_REMETENTE="Tasca do Zé <no-reply@tascadoze.pt>"
# Em produção: código secreto pedido ao criar a 1.ª conta (admin). Gera um aleatório.
CODIGO_CONFIGURACAO=""
# Proxies à frente do servidor (Render = 1). Por omissão: 1 em produção, 0 em desenvolvimento.
# TRUST_PROXY=1
# Opcional: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=""
